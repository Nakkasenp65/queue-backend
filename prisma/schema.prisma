generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("MONGO_URL")
}

enum AppointmentType {
  ONSITE
  ONLINE
  OFFSITE
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
  OFFERED
  WAITING_FOR_PAYMENT
  PAYMENT_RECEIVED
  PAYMENT_CONFIRMED
  PAYMENT_INVALID
  ACCEPTED_BY_EMPLOYEE
  REJECTED_BY_EMPLOYEE
}

enum EmployeeResponse {
  ACCEPT
  REJECT
  OFFER
}

enum NotificationType {
  NEW_BOOKING_REQUEST
  BOOKING_MODIFIED_BY_USER
  BOOKING_CANCELLED_BY_USER_ALERT
  QUEUE_CHECK_IN
  BOOKING_NEW_TIME_OFFER
  BOOKING_RECEIVED
  BOOKING_CONFIRMED
  BOOKING_REJECTED
  BOOKING_MODIFIED_BY_STAFF
  BOOKING_CANCELLED_BY_STAFF
  BOOKING_CANCELLED_BY_USER
  QUEUE_REMINDER_UPCOMING
  QUEUE_REMINDER_IMMINENT
  QUEUE_CALLED
  QUEUE_SKIPPED
  FEEDBACK_REQUEST
  SYSTEM_ANNOUNCEMENT
  PROMOTION_ALERT
  TEST
  ERROR
}

model Customer {
  id                String            @id @default(auto()) @map("_id") @db.ObjectId
  line_display_name String?
  fullname          String?
  phone             String?           @unique
  line_user_id      String            @unique
  email             String?
  picture_url       String?
  appointments      Appointment[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  NotificationLog   NotificationLog[]
}

model Appointment {
  id               String            @id @default(auto()) @map("_id") @db.ObjectId
  type             AppointmentType
  status           AppointmentStatus @default(PENDING)
  serviceType      String
  date             DateTime
  day              String
  section          String
  customer         Customer          @relation(fields: [customerId], references: [id])
  customerId       String            @db.ObjectId
  note             String?
  requiredTags     String[] // Array of tags required for this appointment (e.g., ["ENGINEER", "REFINANCE"])
  employeeResponse EmployeeResponse? // Employee's response: ACCEPT, REJECT, or OFFER
  notification     NotificationLog[]
  adminInfo        Json? // Optional: Information about the employee handling the appointment
  offerDate        DateTime? // Optional: Proposed new date/time if employee offers a new slot
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  score            Int? // 1 - 5 from customer feedback
  feedback         String?
  slipUrl          String?

  @@index([customerId, date])
  @@index([requiredTags])
}

model NotificationLog {
  id            String           @id @default(auto()) @map("_id") @db.ObjectId
  type          NotificationType
  appointment   Appointment?     @relation(fields: [appointmentId], references: [id])
  appointmentId String?          @db.ObjectId
  recipient     Customer?        @relation(fields: [customerId], references: [id])
  recipientId   String?          @db.ObjectId
  title         String
  description   String?
  service       String?
  isRead        Boolean          @default(false)
  readAt        DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  customerId    String?          @db.ObjectId
}
