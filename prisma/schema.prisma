generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("MONGO_URL")
}

enum AppointmentType {
  ONSITE
  ONLINE
  OFFSITE
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
  OFFERED
  ACCEPTED_BY_EMPLOYEE
  REJECTED_BY_EMPLOYEE
}

enum EmployeeResponse {
  ACCEPT
  REJECT
  OFFER
}

model Customer {
  id                String        @id @default(auto()) @map("_id") @db.ObjectId
  line_display_name String?
  fullname          String?
  phone             String?       @unique
  line_user_id      String        @unique
  email             String?
  picture_url       String?
  appointments      Appointment[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model Appointment {
  id               String            @id @default(auto()) @map("_id") @db.ObjectId
  type             AppointmentType
  status           AppointmentStatus @default(PENDING)
  serviceType      String
  date             DateTime
  day              String
  section          String
  customer         Customer          @relation(fields: [customerId], references: [id])
  customerId       String            @db.ObjectId
  note             String?
  requiredTags     String[] // Array of tags required for this appointment (e.g., ["ENGINEER", "REFINANCE"])
  employeeResponse EmployeeResponse? // Employee's response: ACCEPT, REJECT, or OFFER
  adminInfo        Json? // Optional: Information about the employee handling the appointment
  offerDate        DateTime? // Optional: Proposed new date/time if employee offers a new slot
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  score            Int? // 1 - 5 from customer feedback
  feedback         String?

  @@index([customerId, date])
  @@index([requiredTags])
}

model NotificationLog {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  customerId    String?  @db.ObjectId
  appointmentId String?  @db.ObjectId
  employeeInfo  String?
  message       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([customerId])
  @@index([appointmentId])
}
